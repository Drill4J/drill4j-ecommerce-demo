# ─── Port mapping (host side) ─────────────────────────────────────────────────
AUTH_HOST_PORT=8081
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=80

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins the backend will accept requests from.
# Must match the URL users open in the browser.
CORS_ALLOWED_ORIGINS=http://localhost

# ─── JVM tuning (+ Drill4J agent) ─────────────────────────────────────────────
# Heap flags plus Java-mode agent (files from drill4j_agent-files volume).
# Start docker/drill4j first so agent-files downloads drill-runtime.jar (JAVA_AGENT_VERSION).
JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m -javaagent:/data/agent/drill-runtime.jar

# ─── Drill4J ──────────────────────────────────────────────────────────────────
# API key for Drill Admin. Gradle defaults to the same key and to
# http://localhost:8090/api when these are unset.
DRILL_API_KEY=enter-your-drill4j-api-key-here

# Used by Docker Compose for the Drill4J Java agent. Points at Drill Admin on the host
# (equivalent to http://localhost:8090/api from outside containers).
DRILL_API_URL=http://host.docker.internal:8090/api

JAVA_AGENT_VERSION=0.11.0
DRILL_GROUP_ID=ecommerce
