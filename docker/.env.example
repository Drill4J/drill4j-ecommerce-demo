# ─── Port mapping (host side) ─────────────────────────────────────────────────
AUTH_HOST_PORT=8081
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=80

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins the backend will accept requests from.
# Must match the URL users open in the browser.
CORS_ALLOWED_ORIGINS=http://localhost

# ─── JVM tuning ───────────────────────────────────────────────────────────────
# Adjust heap sizes to your server's available memory.
JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m

# ─── Drill4J ──────────────────────────────────────────────────────────────────
# API key for Drill Admin. Gradle defaults to the same key and to
# http://localhost:8090/api when these are unset.
DRILL_API_KEY=enter-your-drill4j-api-key-here
# Used by Docker Compose for the backend agent. Points at Drill Admin on the host
# (equivalent to http://localhost:8090/api from outside containers).
DRILL_API_URL=http://host.docker.internal:8090/api
